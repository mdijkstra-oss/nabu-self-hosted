# Provider API keys. OPENAI_API_KEY is always required: the embeddings
# service uses it unconditionally. The others are needed only when the
# selected models yaml names their provider — preflight tells you which.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Reachable only from a bring-your-own models yaml (MODELS_FILE).
#OPENROUTER_API_KEY=

# Models preset: openai, anthropic, gemini, deepseek, or multi.
MODELS=openai
# Host path to your own models yaml; when set it wins and MODELS is ignored.
#MODELS_FILE=

# Host side of the stack's single published port.
NABU_PORT=8090

# Source of storage's /data mount. The default is a named volume; any other
# value must be a ./ or absolute host path to a directory writable by
# uid 65532, storage's fixed container user.
STORAGE_DATA=projects

# Side-by-side development: point a service's build context at a local
# working copy instead of the pinned GitHub URL.
#NABU_FRONTEND_REPO=
#NABU_STORAGE_REPO=
#NABU_EMBEDDINGS_REPO=
#NABU_PROMPTS_REPO=
#CHANCERY_REPO=
#DRAGOMAN_REPO=
