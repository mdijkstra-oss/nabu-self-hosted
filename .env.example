# Provider API keys. OPENAI_API_KEY is always required: the embeddings
# service uses it unconditionally, and the stack refuses to start without it.
# The others are needed only when the selected models yaml names their
# provider, and a model missing its key fails when it is first used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Reachable only from a models yaml of your own naming openrouter/ models.
#OPENROUTER_API_KEY=

# Which models yaml chancery reads. A bare name is one of the five nabu-prompts
# ships: models.openai.yaml, models.anthropic.yaml, models.gemini.yaml,
# models.deepseek.yaml, models.multi.yaml. An absolute path reads a table you
# mounted into chancery yourself. Changing it takes a restart, not a rebuild.
MODELS=models.openai.yaml

# Host side of the stack's single published port.
NABU_PORT=8090

# Required. The directory project files are written to, as a ./-relative or
# absolute host path — relative resolves against this file's directory, not
# your shell. It must already exist and be writable by uid 65532, storage's
# fixed container user. Copy sample-project/ somewhere and point here to
# start with a project instead of an empty install.
PROJECT_DIR=

# Side-by-side development: point a service at a local working copy. Compose
# builds from it instead of the pinned GitHub URL, and the Procfile watches
# and builds it instead of the relative default.
#NABU_FRONTEND_REPO=
#NABU_STORAGE_REPO=
#NABU_EMBEDDINGS_REPO=
#NABU_PROMPTS_REPO=
#CHANCERY_REPO=
#DRAGOMAN_REPO=
